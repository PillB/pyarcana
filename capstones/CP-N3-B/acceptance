#!/usr/bin/env python3
"""CP-N3-B acceptance — 6 edge questions + bounded path + auth filter + reproducibility."""
import sys, json
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))
from solution import build_graph, path_search, edge_questions, export_case

def check(n,c,d=""): print(f"[{'PASS' if c else 'FAIL'}] {n}" + (f" — {d}" if d else "")); return c

def main():
    ok = True
    entities = [{"id":"E1","type":"person"},{"id":"E2","type":"person"},{"id":"E3","type":"company"}]
    evidence = [{"src":"E1","dst":"E2","type":"co_address","source":"registry","ts":"2026-01-01","direct":True,"uncertainty":0.2,"auth":"internal","meaning":"shared address"},
                {"src":"E2","dst":"E3","type":"director","source":"registry","ts":"2026-01-01","direct":True,"uncertainty":0.1,"auth":"restricted","meaning":"director role"}]
    edges = build_graph(entities, evidence)
    ok &= check("edges built", len(edges)==2)
    ok &= check("direct/inferred flagged", all(hasattr(e,'direct') for e in edges))
    ok &= check("uncertainty present", all(e.uncertainty>=0 for e in edges))
    # 6 questions
    q = edge_questions(edges[0])
    for key in ["source","meaning","not_meaning","age","who_may_see","correctable"]:
        ok &= check(f"edge answers {key}", q.get(key) is not None)
    ok &= check("edge says no kinship", "kinship" in edges[0].not_meaning)
    # Bounded path search
    paths = path_search(edges, "E1", "E3", max_depth=3, auth_scope="restricted")
    ok &= check("path found (restricted)", len(paths)>0)
    paths2 = path_search(edges, "E1", "E3", max_depth=3, auth_scope="internal")
    ok &= check("path blocked (internal can't see restricted)", len(paths2)==0)
    # Depth limit
    paths3 = path_search(edges, "E1", "E3", max_depth=1, auth_scope="restricted")
    ok &= check("depth limit blocks", len(paths3)==0)
    # Reproducibility
    case = export_case(entities, evidence)
    ok &= check("case reproducible", case["reproducible"] is True)
    ok &= check("no fraud labels", case["no_fraud_labels"] is True)
    print(f"\n{'ALL PASS' if ok else 'SOME FAILED'}"); return 0 if ok else 1

if __name__=="__main__": sys.exit(main())
