#!/usr/bin/env python3
"""CP-N4-B acceptance — lineage + registry + parity + canary + PROVEN rollback."""
import sys, json
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))
from solution import MLPlatform, run_platform

def check(n,c,d=""): print(f"[{'PASS' if c else 'FAIL'}] {n}" + (f" — {d}" if d else "")); return c

def main():
    ok = True
    p = MLPlatform()
    ds = p.version_dataset([{"x":1}])
    ok &= check("dataset versioned", ds.startswith("ds-"))
    art = p.register("m1", ds, 0.85, 0.84)
    ok &= check("model registered with signature", len(art.signature)==16)
    ok &= check("train/serve parity ok", art.status=="parity_ok")
    dep = p.deploy("m1","canary")
    ok &= check("deployment has SLO", "slo" in dep and dep["slo"]["p95_latency_ms"]==200)
    # Skew detection
    art2 = p.register("m1", ds, 0.85, 0.50)
    ok &= check("train/serve skew detected", art2.status=="parity_skew")
    # Rollback proven
    rb = p.canary_check("m1", slo_met=False)
    ok &= check("rollback executed (proven)", rb["rolled_back"] is True and rb["proven"] is True)
    ok &= check("incident recorded", len(p.incidents)==1)
    # Full run
    r = run_platform()
    ok &= check("full run has lineage", "lineage" in r)
    ok &= check("registry has 2 versions", len(r["registry"])>=2)
    print(f"\n{'ALL PASS' if ok else 'SOME FAILED'}"); return 0 if ok else 1

if __name__=="__main__": sys.exit(main())
