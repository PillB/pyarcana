#!/usr/bin/env python3
"""CP-N1-C — Familiarity Evidence Dashboard. Computes similarity features,
keeps ER/relationship/risk evidence SEPARATE. Never infers fraud/kinship."""
import json, re, math, sys
from dataclasses import dataclass, asdict

def jaro_winkler(a: str, b: str) -> float:
    if a==b: return 1.0
    if not a or not b: return 0.0
    match_dist = max(len(a),len(b))//2 - 1
    match_dist = max(0, match_dist)
    a_match = [False]*len(a); b_match = [False]*len(b)
    matches = 0
    for i in range(len(a)):
        start = max(0, i-match_dist); end = min(i+match_dist+1, len(b))
        for j in range(start, end):
            if not b_match[j] and a[i]==b[j]: a_match[i]=b_match[j]=True; matches+=1; break
    if matches==0: return 0.0
    t = 0; k = 0
    for i in range(len(a)):
        if a_match[i]:
            while not b_match[k]: k+=1
            if a[i]!=b[k]: t+=1
            k+=1
    t /= 2
    jaro = (matches/len(a) + matches/len(b) + (matches-t)/matches) / 3
    prefix = 0
    for i in range(min(4, len(a), len(b))):
        if a[i]==b[i]: prefix+=1
        else: break
    return jaro + prefix * 0.1 * (1 - jaro)

def token_ratio(a: str, b: str) -> float:
    sa, sb = set(a.lower().split()), set(b.lower().split())
    if not sa or not sb: return 0.0
    return len(sa & sb) / len(sa | sb)

def haversine(lat1, lon1, lat2, lon2) -> float:
    R = 6371
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = math.radians(lat2-lat1); dl = math.radians(lon2-lon1)
    a = math.sin(dp/2)**2 + math.cos(p1)*math.cos(p2)*math.sin(dl/2)**2
    return R * 2 * math.atan2(math.sqrt(a), math.sqrt(1-a))

def temporal_overlap(s1, e1, s2, e2) -> int:
    return max(0, min(e1,e2) - max(s1,s2))

@dataclass
class FamiliarityEvidence:
    pair_id: str; er_evidence: dict; relationship_evidence: dict
    risk_decision: dict; provenance: dict; uncertainty: float

def compute_evidence(pair: dict) -> FamiliarityEvidence:
    a, b = pair["a"], pair["b"]
    er = {"name_jw": round(jaro_winkler(a["name"].lower(), b["name"].lower()),3),
          "name_token": round(token_ratio(a["name"], b["name"]),3),
          "dob_match": a.get("dob")==b.get("dob")}
    rel = {"shared_address": a.get("address")==b.get("address"),
           "geo_proximity_km": round(haversine(a.get("lat",0),a.get("lon",0),b.get("lat",0),b.get("lon",0)),2) if a.get("lat") else None,
           "temporal_overlap_days": temporal_overlap(a.get("start",0),a.get("end",0),b.get("start",0),b.get("end",0))}
    risk = {"decision": "review", "auto_inferred": False,  # NEVER auto-infer fraud/kinship
            "human_review_required": True}
    prov = {"sources": pair.get("sources",[]), "computed_at": "2026-07-30"}
    unc = round(1.0 - max(er["name_jw"], er["name_token"]), 3)
    return FamiliarityEvidence(pair["pair_id"], er, rel, risk, prov, unc)

def main():
    pairs = json.loads(sys.stdin.read())["pairs"]
    results = [asdict(compute_evidence(p)) for p in pairs]
    print(json.dumps({"evidence": results}, indent=2))

if __name__=="__main__": main()
