#!/usr/bin/env python3
"""CP-N2-C acceptance — approval gate + allowlist + audit + rollback + idempotency."""
import sys, json
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))
from solution import run_workflow, WorkflowRunner, RECIPIENT_ALLOWLIST

def check(n,c,d=""): print(f"[{'PASS' if c else 'FAIL'}] {n}" + (f" — {d}" if d else "")); return c

def main():
    ok = True
    doc = {"run_id":"R1","client_id":"ACME-001","amount":"1000","recipient":"ana.review@synthetic.example"}
    # No approval → no send
    r = run_workflow(doc, approved=False, test_mode=True)
    ok &= check("no approval → not sent", r["email"]["sent"] is False)
    ok &= check("audit trail present", len(r["audit"])>=3)
    ok &= check("idempotency key", bool(r["idempotency_key"]))
    # With approval + test mode → test, not real send
    r2 = run_workflow(doc, approved=True, test_mode=True)
    ok &= check("test mode → not actually sent", r2["email"]["sent"] is False and r2["email"].get("test_mode"))
    # Non-allowlisted recipient blocked
    doc2 = {**doc, "recipient":"evil@example.com"}
    r3 = run_workflow(doc2, approved=True, test_mode=False)
    ok &= check("non-allowlist blocked", r3["email"]["sent"] is False and "allowlist" in r3["email"]["reason"])
    # Rollback
    runner = WorkflowRunner()
    runner.sent.append({"to":"x","subject":"y","body":"z"})
    rb = runner.rollback("R1")
    ok &= check("rollback clears sends", rb["rolled_back"] and rb["cleared"]==1)
    # Redacted logs
    ok &= check("audit redacted", all("password=" not in a.redacted_detail for a in runner.audit))
    print(f"\n{'ALL PASS' if ok else 'SOME FAILED'}"); return 0 if ok else 1

if __name__=="__main__": sys.exit(main())
