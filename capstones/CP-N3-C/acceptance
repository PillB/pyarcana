#!/usr/bin/env python3
"""CP-N3-C acceptance — baseline + leakage + calibration + abstention + model card."""
import sys, json
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))
from solution import run_triage, deterministic_baseline, leakage_proof_split, choose_threshold, abstain, model_card

def check(n,c,d=""): print(f"[{'PASS' if c else 'FAIL'}] {n}" + (f" — {d}" if d else "")); return c

def main():
    ok = True
    recs = [{"id":str(i),"amount":str(i*20),"timestamp":f"2026-01-{i:02d}","subgroup":"A" if i%2 else "B"} for i in range(1,21)]
    r = run_triage(recs)
    ok &= check("decisions produced", len(r["decisions"])>0)
    ok &= check("leakage-proof split", "time-aware" in r["split"])
    ok &= check("threshold chosen", 0 < r["threshold"]["threshold"] < 1)
    ok &= check("threshold has rationale", bool(r["threshold"]["rationale"]))
    ok &= check("abstention present", any(d["decision"]=="abstain" for d in r["decisions"]))
    ok &= check("no unreviewed adverse", r["no_unreviewed_adverse"] is True)
    ok &= check("model card present", "intended_use" in r["model_card"])
    ok &= check("model card has monitoring", "drift" in r["model_card"]["monitoring"])
    ok &= check("model card out_of_scope", len(r["model_card"]["out_of_scope"])>=2)
    # Baseline beats majority
    scores = deterministic_baseline(recs)
    ok &= check("baseline produces scores", len(scores)==len(recs) and all(0<=s<=1 for s in scores))
    # Cost-aware threshold
    thr = choose_threshold([0.3,0.6,0.8],[0,1,1], cost_fp=1, cost_fn=10)
    ok &= check("cost-aware threshold", 0 < thr["threshold"] < 1)
    print(f"\n{'ALL PASS' if ok else 'SOME FAILED'}"); return 0 if ok else 1

if __name__=="__main__": sys.exit(main())
