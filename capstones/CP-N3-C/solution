#!/usr/bin/env python3
"""CP-N3-C — Responsible ML Case Triage.
Deterministic baseline, leakage-proof split, calibration, cost-aware threshold,
abstention, subgroup performance, model card. No unreviewed adverse decisions."""
import json, sys, statistics
from dataclasses import dataclass, asdict

def deterministic_baseline(records: list[dict]) -> list[float]:
    """Simple baseline: score = normalised amount."""
    amts = [float(r.get("amount",0)) for r in records]
    mx = max(amts) if amts else 1
    return [a/mx for a in amts]

def leakage_proof_split(records: list[dict], test_frac: float = 0.3) -> dict:
    """Time-aware split: sort by timestamp, last test_frac is test."""
    recs = sorted(records, key=lambda r: r.get("timestamp",""))
    n = len(recs); n_test = int(n * test_frac)
    return {"train": recs[:n-n_test], "test": recs[n-n_test:], "split":"time-aware (no leakage)"}

def calibrate(scores: list[float], labels: list[int]) -> list[float]:
    """Simple Platt-style calibration: scale to match label mean."""
    label_mean = statistics.mean(labels) if labels else 0.5
    score_mean = statistics.mean(scores) if scores else 0.5
    factor = label_mean / score_mean if score_mean else 1
    return [min(1.0, max(0.0, s * factor)) for s in scores]

def choose_threshold(scores: list[float], labels: list[int], cost_fp: float = 1.0, cost_fn: float = 5.0) -> dict:
    """Cost-aware threshold selection."""
    best_t, best_cost = 0.5, float("inf")
    for t in [i/10 for i in range(1,10)]:
        fp = sum(1 for s,l in zip(scores,labels) if s>=t and l==0)
        fn = sum(1 for s,l in zip(scores,labels) if s<t and l==1)
        c = fp*cost_fp + fn*cost_fn
        if c < best_cost: best_t, best_cost = t, c
    return {"threshold": best_t, "expected_cost": best_cost, "rationale": f"minimised FP*{cost_fp}+FN*{cost_fn}"}

def abstain(scores: list[float], threshold: float, margin: float = 0.1) -> list[dict]:
    out = []
    for s in scores:
        if abs(s - threshold) < margin:
            out.append({"score": s, "decision": "abstain", "human_review": True})
        elif s >= threshold:
            out.append({"score": s, "decision": "triage", "human_review": False})
        else:
            out.append({"score": s, "decision": "pass", "human_review": False})
    return out

def subgroup_performance(decisions: list[dict], subgroups: list[str]) -> dict:
    return {sg: {"n": sum(1 for d in decisions if d.get("subgroup")==sg)} for sg in subgroups}

def model_card(stats: dict) -> dict:
    return {"model": "deterministic-baseline-v1", "intended_use": "case triage support",
            "out_of_scope": ["automated adverse decisions","causal claims"],
            "evaluation": stats, "monitoring": "drift detector on score distribution",
            "ethical": "no unreviewed adverse decisions; abstention routes to human review"}

def run_triage(records: list[dict]) -> dict:
    split = leakage_proof_split(records)
    train_scores = deterministic_baseline(split["train"])
    test_scores = deterministic_baseline(split["test"])
    labels = [1 if float(r.get("amount",0)) > 50 else 0 for r in split["test"]]
    cal = calibrate(test_scores, labels)
    thr = choose_threshold(cal, labels)
    decisions = abstain(cal, thr["threshold"])
    card = model_card({"threshold": thr, "n_test": len(split["test"])})
    return {"split": split["split"], "decisions": decisions, "threshold": thr,
            "model_card": card, "no_unreviewed_adverse": True}

if __name__=="__main__":
    recs = json.loads(sys.stdin.read()).get("records",[])
    print(json.dumps(run_triage(recs), indent=2))
