#!/usr/bin/env python3
"""CP-N2-A — EDA Portfolio. Profiles, missingness, segments, executive memo
with 5-part structure: observation/association/hypothesis/recommendation/limitation."""
import json, statistics, sys
from dataclasses import dataclass, asdict
from collections import Counter

def profile(records: list[dict]) -> dict:
    fields = list(records[0].keys()) if records else []
    return {"row_count": len(records), "fields": fields,
            "missing": {f: sum(1 for r in records if not r.get(f)) for f in fields}}

def missingness_mechanism(field: str, records: list[dict]) -> str:
    """Heuristic: MCAR if missingness ~uniform; MAR if correlated with another field; MNAR if >50% missing."""
    n = len(records); missing = sum(1 for r in records if not r.get(field))
    rate = missing / n if n else 0
    if rate > 0.5: return "MNAR"
    if rate < 0.05: return "MCAR"
    return "MAR"

def segment_compare(records: list[dict], seg_field: str, metric: str) -> dict:
    segs = {}
    for r in records:
        s = r.get(seg_field, "unknown")
        segs.setdefault(s, []).append(float(r.get(metric, 0)))
    return {s: {"mean": round(statistics.mean(v),2), "n": len(v)} for s, v in segs.items() if v}

def executive_memo(findings: dict) -> dict:
    return {
        "observation": f"Dataset has {findings['profile']['row_count']} rows across {len(findings['profile']['fields'])} fields.",
        "association": f"Segment comparison shows variation: {findings['segments']}.",
        "hypothesis": "The observed segment differences may reflect sampling or genuine population effects; no causal claim is made.",
        "recommendation": "Investigate segment-specific data collection before acting.",
        "limitation": "This analysis is descriptive; causal inference would require additional controls.",
    }

def run_eda(records: list[dict]) -> dict:
    prof = profile(records)
    miss = {f: missingness_mechanism(f, records) for f in prof["fields"]}
    segs = segment_compare(records, "segment", "amount") if "segment" in prof["fields"] and "amount" in prof["fields"] else {}
    memo = executive_memo({"profile": prof, "segments": segs})
    return {"profile": prof, "missingness": miss, "segments": segs, "executive_memo": memo}

if __name__=="__main__":
    data = json.loads(sys.stdin.read())
    recs = data.get("records", data) if isinstance(data, dict) else data
    print(json.dumps(run_eda(recs), indent=2))
