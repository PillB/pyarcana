#!/usr/bin/env python3
"""CP-N1-B — Reproducible ETL Pipeline. Ingests CSV/JSON, validates contracts,
separates accepted/quarantined, produces deterministic outputs with manifests."""
import csv, json, hashlib, sys
from pathlib import Path
from dataclasses import dataclass, asdict

CONTRACT = {"required": ["txn_id","client_id","amount","currency","timestamp"], "types": {"amount":"float","txn_id":"str"}}

@dataclass
class ETLRecord:
    txn_id: str; client_id: str; amount: float; currency: str; timestamp: str
    status: str; reason: str; source_hash: str

def hash_row(row: dict) -> str:
    return hashlib.sha1(json.dumps(row, sort_keys=True).encode()).hexdigest()[:16]

def validate(row: dict) -> ETLRecord:
    reasons = []
    for f in CONTRACT["required"]:
        if f not in row or row[f] in ("", None): reasons.append(f"missing {f}")
    try: float(row.get("amount", 0))
    except: reasons.append("amount not numeric")
    status = "accepted" if not reasons else "quarantined"
    return ETLRecord(str(row.get("txn_id","")), str(row.get("client_id","")),
        float(row.get("amount",0)), str(row.get("currency","")), str(row.get("timestamp","")),
        status, "; ".join(reasons), hash_row(row))

def run_etl(input_path: str, output_dir: str = "output") -> dict:
    p = Path(input_path); text = p.read_text(encoding="utf-8", errors="replace")
    rows = json.loads(text)["records"] if p.suffix == ".json" else list(csv.DictReader(text.splitlines()))
    records = [validate(r) for r in rows]
    accepted = [r for r in records if r.status == "accepted"]
    quarantined = [r for r in records if r.status == "quarantined"]
    manifest = {"input": input_path, "input_hash": hashlib.sha1(text.encode()).hexdigest(),
        "accepted": len(accepted), "quarantined": len(quarantined),
        "output_hashes": {}}
    out = Path(output_dir); out.mkdir(exist_ok=True)
    for name, data in [("accepted.json", accepted), ("quarantined.json", quarantined)]:
        content = json.dumps([asdict(r) for r in data], indent=2)
        (out/name).write_text(content)
        manifest["output_hashes"][name] = hashlib.sha1(content.encode()).hexdigest()[:16]
    (out/"manifest.json").write_text(json.dumps(manifest, indent=2))
    return manifest

if __name__ == "__main__":
    import argparse
    p = argparse.ArgumentParser(); p.add_argument("input"); p.add_argument("-o","--output",default="output")
    a = p.parse_args(); m = run_etl(a.input, a.output)
    print(json.dumps(m, indent=2))
