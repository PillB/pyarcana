#!/usr/bin/env python3
"""CP-FINAL acceptance — 12 deps + contracts + E2E + no-go + contribution."""
import sys, json
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))
from solution import run_final, contract_tests, end_to_end_trace, no_go_condition, contribution_statement, INTERFACES

def check(n,c,d=""): print(f"[{'PASS' if c else 'FAIL'}] {n}" + (f" — {d}" if d else "")); return c

def main():
    ok = True
    r = run_final()
    ok &= check("12 dependencies present", len(r["twelve_dependencies"])==12)
    ok &= check("all 12 interfaces versioned /v1/", all(i["version"]=="/v1/" for i in r["interfaces"]))
    ok &= check("contract tests run", r["contract_tests"]["total"]==12)
    ok &= check("E2E trace has shared scenario", r["end_to_end_trace"]["shared_scenario"]=="ACME-001")
    ok &= check("E2E trace has trace_id", bool(r["end_to_end_trace"]["trace_id"]))
    ok &= check("E2E has >=3 steps", len(r["end_to_end_trace"]["steps"])>=3)
    ok &= check("no-go condition checked", "no_go" in r["no_go_condition"])
    ok &= check("contribution statement present", bool(r["contribution_statement"]))
    ok &= check("no fraud prevention claim", "fraud prevention" not in r["contribution_statement"] or "No claim" in r["contribution_statement"])
    ok &= check("no money saved claim", "money saved" not in r["contribution_statement"] or "No claim" in r["contribution_statement"])
    print(f"\n{'ALL PASS' if ok else 'SOME FAILED'}"); return 0 if ok else 1

if __name__=="__main__": sys.exit(main())
