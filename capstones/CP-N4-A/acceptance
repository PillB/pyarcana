#!/usr/bin/env python3
"""CP-N4-A acceptance — versioned API, authz, rate limit, health, backup/restore."""
import sys, json, tempfile, os
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))
from solution import authz, rate_limit_check, redact, backup, restore, log_request, request_log, SCOPES

def check(n,c,d=""): print(f"[{'PASS' if c else 'FAIL'}] {n}" + (f" — {d}" if d else "")); return c

def main():
    ok = True
    # Authz
    ok &= check("valid token + scope", authz("token-ana","read:clients") is True)
    ok &= check("valid token wrong scope", authz("token-ana","write:clients") is False)
    ok &= check("invalid token", authz("bad","read:clients") is False)
    # Rate limit
    ok &= check("rate limit allows first", rate_limit_check("token-ana") is True)
    # Redaction
    r = redact("Bearer secret-token-1234 and card 4111-1111-1111-1111")
    ok &= check("token redacted", "secret-token-1234" not in r)
    ok &= check("card redacted", "4111-1111-1111-1111" not in r)
    # Backup/restore
    data = {"clients":[{"id":"C1"}],"txns":[{"id":"T1"}]}
    with tempfile.TemporaryDirectory() as d:
        b = backup(data, os.path.join(d,"bk.json"))
        ok &= check("backup created", b["hash"] and b["rows"]==2)
        r2 = restore(os.path.join(d,"bk.json"))
        ok &= check("restore roundtrip", r2==data)
    # Scopes defined
    ok &= check("scopes defined", "read:clients" in SCOPES and "write:clients" in SCOPES)
    print(f"\n{'ALL PASS' if ok else 'SOME FAILED'}"); return 0 if ok else 1

if __name__=="__main__": sys.exit(main())
