{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "section_id",
    "patches",
    "unresolved_questions"
  ],
  "properties": {
    "section_id": {
      "type": "string"
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_ids",
          "field_path",
          "anchor",
          "replacement",
          "rationale",
          "terms_introduced",
          "file",
          "self_critique"
        ],
        "properties": {
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "field_path": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "terms_introduced": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string",
            "description": "Repo-relative file this patch applies to. Omit for the section file."
          },
          "self_critique": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "what_could_confuse",
              "what_is_missing",
              "addressed_in_this_replacement",
              "residual_concern"
            ],
            "properties": {
              "what_could_confuse": {
                "type": "string",
                "description": "Read this replacement as a learner who knows only what earlier sections taught. What could they misread, and how?"
              },
              "what_is_missing": {
                "type": "string",
                "description": "What a learner needs here that the replacement still does not give them."
              },
              "addressed_in_this_replacement": {
                "type": "boolean",
                "description": "True only if the replacement already fixes the two answers above. Revise before answering true."
              },
              "residual_concern": {
                "type": "string",
                "description": "What remains wrong if addressed is false, or an empty string. Never invent a concern to fill this."
              }
            }
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_ids",
          "question",
          "why_it_blocks",
          "options"
        ],
        "properties": {
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": "string"
          },
          "why_it_blocks": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
