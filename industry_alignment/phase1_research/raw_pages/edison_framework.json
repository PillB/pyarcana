n<link type=\"text/css\" rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css?family=Roboto:400,700,400italic&amp;subset=latin,greek\" media=\"all\">\n<link type=\"text/css\" rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css?family=Open+Sans:400,400i,700,700i&amp;subset=greek\" media=\"all\">\n<link type=\"text/css\" rel=\"stylesheet\" href=\"https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css\" media=\"all\">\n<link type=\"text/css\" rel=\"stylesheet\" href=\"/sites/edison-project.eu/files/css/css_lwAY3wC8Nu6aeyvI1SUkJHsLLgv0mvfR7DhYUAETlMw.css\" media=\"all\">\n<link type=\"text/css\" rel=\"stylesheet\" href=\"/sites/edison-project.eu/files/css/css_32eFU78Ec4B-kOCin2QF-vzOtiFmMdoM__zS1qrGs_E.css\" media=\"print\">\n<link type=\"text/css\" rel=\"stylesheet\" href=\"/sites/edison-project.eu/files/css/css_BFpfJU5qMlll8WXAsw43yxMwjpLgzlHGNy03lStqGtc.css\" media=\"all\">\n\n<!--[if lte IE 8]>\n<link type=\"text/css\" rel=\"stylesheet\" href=\"/sites/edison-project.eu/files/css/css_18n6Xx7ZR4YUfpjKjB3GJEP6xDvDxrVyspia0QquR_I.css\" media=\"all\" />\n<![endif]-->\n<link type=\"text/css\" rel=\"stylesheet\" href=\"/sites/edison-project.eu/files/css/css_x_Wxz_svyD5LKNMCuR1x1oDGZ1rT38JuWQUrD78w1Yw.css\" media=\"all\">\n\n<!--[if lte IE 8]>\n<link type=\"text/css\" rel=\"stylesheet\" href=\"/sites/edison-project.eu/files/css/css_x_Wxz_svyD5LKNMCuR1x1oDGZ1rT38JuWQUrD78w1Yw.css\" media=\"all\" />\n<![endif]-->\n  <script src=\"/sites/edison-project.eu/files/js/js_peFMcQ4h_8YUutZRn1-R0zc9UJ8I7jaxW6vj6UHqPx4.js\"></script>\n<script src=\"/sites/edison-project.eu/files/js/js_gPqjYq7fqdMzw8-29XWQIVoDSWTmZCGy9OqaHppNxuQ.js\"></script>\n\n<script src=\"/sites/edison-project.eu/files/js/js_tzEGTRyjbSNo4GS4Eh6_ZJb5BgaDvQF9UshkdxwThp0.js\"></script>\n<script src=\"/sites/edison-project.eu/files/js/js_WnBf8niVFyswgqej42ZFK8a_dUoBKJi5Gxkh-qoCWDE.js\"></script>\n\n</head>\n<body class=\"html not-front not-logged-in page-node page-node- page-node-488 node-type-page section-edison\">\n  <a href=\"#main-content\" class=\"element-invisible element-focusable\">Skip to main content</a>\n    <div class=\"l-page has-one-sidebar has-sidebar-first\">\n\n      <!-- l-wrapper--top-navigation -->\n    <div class=\"l-wrapper--top-navigation\">\n      <!-- l-region--top-navigation -->\n          </div>\n  \n  <!-- l-wrapper--branding -->\n  <div class=\"l-wrapper--branding\">\n    <div class=\"l-constrained\">\n\n      <!-- l-region--logo -->\n      <div class=\"l-region--logo\">\n                  <a href=\"/\" title=\"Home\" rel=\"home\" class=\"branding__logo\"><img src=\"/sites/edison-project.eu/files/images/edison-project-logo.png\" alt=\"Home\"></a>\n                              </div>\n\n      <!-- l-region--branding -->\n        <div class=\"l-region l-region--branding\">\n    <div id=\"block-block-5\" class=\"block block--block block--block-5\">\n        <div class=\"block__content\">\n    <style type=\"text/css\">\n<!--/*--><![CDATA[/* ><!--*/\n.logo-information {\ncolor: #607D8B;\ntext-align: center;\npadding: 10px;\n}\n@media only screen and (min-width:481px){\n.logo-information {\nmax-width: 200px;\nfloat: right;\n}\n}\n@media only screen and (min-width:660px){\n.logo-information {\nmax-width: 300px;\n}\n}\n@media only screen and (min-width:780px){\n.logo-information {\nmax-width: 400px;\nfloat: right;\n}\n}\n\n/*--><!]]>*/\n</style><p class=\"logo-information\">EDISON is a 2-year project (started September 2015) with the purpose of accelerating the creation of the&nbsp;Data Science&nbsp;profession.</p>\n  </div>\n</div>\n  </div>\n\n    </div>\n  </div>\n\n  \n  \n  \n      <!-- l-wrapper--navigation -->\n    <div class=\"l-wrapper--navigation\">\n      <!-- l-region--navigation -->\n        <div class=\"l-region l-region--navigation\">\n    <nav id=\"block-system-main-menu\" role=\"navigation\" class=\"block block--system block--menu block--system-main-menu\">\n      \n  <ul class=\"menu\"><li class=\"first leaf\"><a href=\"/\">Home</a></li>\n<li class=\"leaf\"><a href=\"/event-agenda\" title=\"Events relating to the EDISON project and Data Science in general\">Events</a></li>\n<li class=\"leaf\"><a href=\"/news\" title=\"News and stories relating to the EDISON project and Data Science in general\">News</a></li>\n<li class=\"leaf\"><a href=\"/library\" title=\"The Library brings together all of the resources relating to the EDISON project\">Library</a></li>\n<li class=\"leaf\"><a href=\"/edison\" title=\"EDISON – Education for Data Intensive Science to Open New science frontiers\">EDISON</a></li>\n<li class=\"leaf\"><a href=\"/edison/engagement-and-interaction/contact\" title=\"Contact details for EDISON, we would love to hear from you.\">Contact</a></li>\n<li class=\"last leaf active-trail\"><a href=\"/edison/edison-data-science-framework-edsf\" title=\"EDISON Data Science Framework (EDSF) document collection\" class=\"active-trail active\">EDISON Data Science Framework (EDSF)</a></li>\n</ul></nav>\n  </div>\n    </div>\n    \n    \n  <!-- l-wrapper--main -->\n  <div class=\"l-wrapper--main\">\n    <div class=\"l-constrained\">\n            <ul class=\"breadcrumb\"><li><a href=\"/\">Home</a></li><li class=\"last\"><a href=\"#\" title=\"You are here\">EDISON Data Science Framework (EDSF)</a></li></ul>\n      <div class=\"l-content\" role=\"main\">\n                <a id=\"main-content\"></a>\n                                        \n\n  <!-- regular node view template HTML  -->\n  <article about=\"/edison/edison-data-science-framework-edsf\" typeof=\"sioc:Item foaf:Document\" role=\"article\" class=\"node node--page node--full node--page--full\">\n\n    \n    \n    <header>\n                    <h1 class=\"node__title\">\n          <a href=\"/edison/edison-data-science-framework-edsf\" rel=\"bookmark\">EDISON Data Science Framework (EDSF)</a>\n        </h1>\n            <span property=\"dc:title\" content=\"EDISON Data Science Framework (EDSF)\" class=\"rdf-meta element-hidden\"></span>    </header>\n\n\n    \n\n    <main class=\"node__content\">\n      <div class=\"field field--name-field-page-intro field--type-text-long field--label-hidden\"><div class=\"field__items\"><div class=\"field__item even\"><p>The EDISON Data Science Framework is a collection of documents that define the Data Science profession. Freely available, these documents have been developed to guide educators and trainers, emplyers and managers, and Data Scientists themselves. This collection of documents collectively breakdown the complexity of the skills and competences need to define Data Science as a professional practice.</p>\n</div></div></div><div class=\"field field--name-field-page-description field--type-text-long field--label-hidden\"><div class=\"field__items\"><div class=\"field__item even\"><h3>EDISON Data Science Framework (EDSF) Release 2, 3 July 2017:</h3>\n<h4>Overviews and introductions:</h4>\n<ul><li><a href=\"/sites/edison-project.eu/files/attached_files/node-488/edison-general-introduction-edsf.pdf\">General&nbsp;introduction to&nbsp;the EDISON Data Science Framework (EDSF)</a></li>\n</ul><h4>Detailed components:</h4>\n<ul><li>EDSF Part 1:&nbsp;<a href=\"/data-science-competence-framework-cf-ds\">Data Science Competences Framework (CF-DS) Release 2</a></li>\n<li>EDSF Part 2. <a href=\"/data-science-body-knowledge-ds-bok\">Data Science Body of Knowledge (DS-BoK)&nbsp;Release 2</a></li>\n<li>EDSF Part 3.&nbsp;<a href=\"/data-science-model-curriculum-mc-ds\">Data Science Model Curriculum (MC-DS) Release 2</a></li>\n<li>EDSF Part 4.&nbsp;<a href=\"/data-science-professional-profiles-definition-dsp\">Data Science Professional Framework (DSPP) Release 2</a></li>\n</ul></div></div></div>    </main>\n\n      <div id=\"book-navigation-7\" class=\"book-navigation\">\n    \n        <div class=\"book-navigation__links\">\n              <a href=\"/edison/national-action-plans/netherlands-national-initiative\" class=\"book-navigation__previous\" title=\"Go to previous page\">‹ The Netherlands: National Initiative</a>\n                    <a href=\"/edison\" class=\"book-navigation__up\" title=\"Go to parent page\">up</a>\n                    <a href=\"/edison/engagement-and-interaction\" class=\"book-navigation__next\" title=\"Go to next page\">Engagement and Interaction ›</a>\n          </div>\n      </div>\n    <ul class=\"links links--inline node__links\"><li class=\"book_printer first last\">Printer-friendly version</li>\n</ul>    \n  </article>\n\n  <section class=\"node-reference\">\n          </section>\n\n              </div>\n\n        <aside class=\"l-region l-region--sidebar-first\">\n    <div id=\"block-book-navigation\" role=\"navigation\" class=\"block block--book block--book-navigation\">\n        <h2 class=\"block__title\">EDISON initiative</h2>\n      <div class=\"block__content\">\n      <div id=\"book-block-menu-7\" class=\"book-block-menu\">\n    <ul class=\"menu\"><li class=\"first last expanded active-trail\"><a href=\"/edison\" class=\"active-trail\">EDISON</a><ul class=\"menu\"><li class=\"first leaf\"><a href=\"/edison/data-scientist-profession\">Data scientist profession</a></li>\n<li class=\"collapsed\"><a href=\"/edison/edison-project\">EDISON Project</a></li>\n<li class=\"collapsed\"><a href=\"/edison/expert-liaison-groups-elg\">Expert Liaison Groups - ELG</a></li>\n<li class=\"collapsed\"><a href=\"/edison/education-and-training-champions\">Education and Training Champions</a></li>\n<li class=\"collapsed\"><a href=\"/edison/national-action-plans\">National Action Plans</a></li>\n<li class=\"leaf active-trail\"><a href=\"/edison/edison-data-science-framework-edsf\" class=\"active-trail active\">EDISON Data Science Framework (EDSF)</a></li>\n<li class=\"last collapsed\"><a href=\"/edison/engagement-and-interaction\">Engagement and Interaction</a></li>\n</ul></li>\n</ul>  </div>\n  </div>\n</div>\n<div id=\"block-views-latest-news-block-block\" class=\"block block--views block--views-latest-news-block-block\">\n        <h2 class=\"block__title\">Latest news</h2>\n      <div class=\"block__content\">\n    <div class=\"view view-latest-news-block view-id-latest_news_block view-display-id-block view-dom-id-6de5d28bc8dcc8c025a332892002805d\">\n        \n  \n  \n      <div class=\"view-content\">\n        <div class=\"views-row views-row-1 views-row-odd views-row-first\">\n      \n  <div class=\"views-field views-field-title\">        <span class=\"field-content\"><a href=\"/third-edison-champions-conference-warsaw-poland\">Third EDISON Champions Conference: Warsaw, Poland</a></span>  </div>  </div>\n  <div class=\"views-row views-row-2 views-row-even\">\n      \n  <div class=\"views-field views-field-title\">        <span class=\"field-content\"><a href=\"/2017-data-science-comes-age\">2017: data science comes of age</a></span>  </div>  </div>\n  <div class=\"views-row views-row-3 views-row-odd\">\n      \n  <div class=\"views-field views-field-title\">        <span class=\"field-content\"><a href=\"/second-edison-champions-conference\">Second EDISON Champions Conference</a></span>  </div>  </div>\n  <div class=\"views-row views-row-4 views-row-even\">\n      \n  <div class=\"views-field views-field-title\">        <span class=\"field-content\"><a href=\"/building-data-science-profession-workshop-di4r-2016\">Building the data science profession: workshop at DI4R 2016</a></span>  </div>  </div>\n  <div class=\"views-row views-row-5 views-row-odd views-row-last\">\n      \n  <div class=\"views-field views-field-title\">        <span class=\"field-content\"><a href=\"/accreditation-and-certification-schemes-rda-8th-plenary-bof-meeting\">Accreditation and certification schemes RDA 8th Plenary BoF meeting</a></span>  </div>  </div>\n    </div>\n  \n  \n  \n  \n  \n  \n</div>  </div>\n</div>\n<div id=\"block-block-3\" class=\"block block--block block--block-3\">\n        <div class=\"block__content\">\n    <p> </p>\n  </div>\n</div>\n  </aside>\n          </d