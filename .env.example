# ─────────────────────────────────────────────────────────────────────
# PyArcana — Variables de entorno
# ─────────────────────────────────────────────────────────────────────
# REGLAS CRÍTICAS:
# 1. NUNCA escribas comandos $(...) en este archivo. Genera el valor en
#    la terminal, copia el resultado, pégalo como valor literal.
# 2. NUNCA uses prefijo NEXT_PUBLIC_ para secretos. Esas variables se
#    incrustan en el JS del navegador y son visibles para cualquiera.
# 3. NUNCA uses localhost en NEXTAUTH_URL en producción.
# 4. NUNCA mezcles IDs sandbox y live del mismo proveedor de pago.
# 5. NUNCA commites un .env real (con secretos) a Git.
#
# Ver: docs/implementation/ENVIRONMENT-MATRIX.md
# ─────────────────────────────────────────────────────────────────────

# ── Base de datos ──
# SQLite. Usar ruta ABSOLUTA en producción (no relativa al CWD).
# Desarrollo local: file:./db/custom.db
# Producción: file:/var/lib/pyarcana/db/custom.db
DATABASE_URL="file:./db/custom.db"

# ── NextAuth (obligatorio en todo despliegue dinámico) ──
# Generar con: openssl rand -base64 32
# Pegar el resultado (NO el comando) como valor.
NEXTAUTH_SECRET=""

# URL pública del LMS dinámico.
# Desarrollo: http://localhost:3000
# Producción: https://pyarcana.dev (NUNCA localhost en producción)
NEXTAUTH_URL="http://localhost:3000"

# ── Firma de credenciales (obligatorio en producción) ──
# Generar con: openssl rand -base64 32
# Pegar el resultado (NO el comando) como valor.
# En producción: si no está seteado, la app falla rápido (fail-fast).
# En desarrollo: si no está seteado, se usa un fallback público (no seguro).
CREDENTIAL_SIGNING_KEY=""

# ── Modo de build ──
# Estático (GitHub Pages): NEXT_PUBLIC_STATIC_SITE=1, NEXT_OUTPUT=export, NEXT_PUBLIC_BASE_PATH=pyarcana
# Dinámico (VPS): dejar sin setear estas tres variables.
# NEXT_PUBLIC_STATIC_SITE=""
# NEXT_OUTPUT=""
# NEXT_PUBLIC_BASE_PATH=""

# ── Firebase mirror (opcional, solo LMS dinámico) ──
# Si no se configuran, el mirror está desactivado. Prisma sigue funcionando.
# La fuente de verdad es Prisma. Firestore es solo un mirror write-only.
# Ver ADR 1 y ADR 3 en docs/implementation/ADRS.md.

# Firebase Admin SDK (servidor). Obtener de Firebase Console → Project settings → Service Accounts.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# La private key incluye saltos de línea como \n. Pegar el valor completo
# que viene en el JSON del service account, incluyendo los \n literales.
FIREBASE_PRIVATE_KEY=""

# Alternativa: pegar el JSON completo del service account en una variable.
# Si se setea, tiene prioridad sobre las tres anteriores.
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Activar/desactivar el mirror. Si unset, se asume false.
# FIREBASE_SYNC_ENABLED="false"

# ── Firebase Client SDK (opcional, para edición estática o cliente) ──
# Si no se configuran, las features de Firebase cliente están desactivadas.
# Obtener de Firebase Console → Project settings → General → Your apps → SDK setup.
# ESTAS VARIABLES SON PÚBLICAS — se incrustan en el bundle del navegador.
# NO son secretas. La seguridad depende de firestore.rules, no de estas claves.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ── Proveedores de pago (FUTURO — no activar en Fase 1) ──
# Sandbox y live usan credenciales DIFERENTES. NUNCA mezclar.
# STRIPE_SECRET_KEY=""        # sk_test_... (sandbox) o sk_live_... (producción)
# STRIPE_WEBHOOK_SECRET=""    # whsec_...
# MERCADOPAGO_ACCESS_TOKEN=""
# LEMON_SQUEEZY_API_KEY=""
# LEMON_SQUEEZY_WEBHOOK_SECRET=""

# ── Email / SMTP (FUTURO — no activar en Fase 1) ──
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="PyArcana <no-reply@pyarcana.dev>"
