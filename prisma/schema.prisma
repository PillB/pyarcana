// Prisma schema — Python DS Perú LMS
// User accounts, progress tracking, smart exams, exercise attempts, subscriptions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null for OAuth-only users
  role         String   @default("STUDENT") // STUDENT | ADMIN
  country      String   @default("PE") // ISO 3166-1 alpha-2 country code
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress             Progress[]
  examAttempts         ExamAttempt[]
  exerciseAttempts     ExerciseAttempt[]
  subscription         Subscription?
  payments             Payment[]
  feedbackReports      FeedbackReport[]
  supervisorProfile    SupervisorProfile?
  ownedCohorts        Cohort[]
  cohortMemberships   CohortMembership[]
  notifications       Notification[]
  notificationPref    NotificationPreference?
}

// User/guest feedback: bugs, ideas, recommendations
model FeedbackReport {
  id         String   @id @default(cuid())
  type       String // BUG | IDEA | RECOMMENDATION | OTHER
  status     String   @default("NEW") // NEW | REVIEWING | PLANNED | DONE | WONTFIX | DUPLICATE
  title      String
  body       String
  sectionId  String?
  pagePath   String?
  userAgent  String?
  email      String?
  userId     String?
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([userId])
}

// Per-user progress tracking for sub-steps (theory, ido, wedo, youdo, quiz)
model Progress {
  userId      String
  sectionId   String
  subStep     String // theory|ido|wedo|youdo|quiz
  completed   Boolean  @default(false)
  completedAt DateTime?
  bookmarked  Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId, subStep])
  @@index([userId, sectionId])
}

// Question bank with 3 variants per concept for anti-plagiarism
model QuestionBank {
  id           String   @id @default(cuid())
  sectionId    String
  concept      String // e.g. "list-comprehension"
  variant      Int // 1 | 2 | 3
  question     String
  options      String // JSON array of strings
  correctIndex Int
  explanation  String
  createdAt    DateTime @default(now())

  @@unique([sectionId, concept, variant])
  @@index([sectionId, concept])
}

// Exam attempt: max 3 per user/section (2 retries)
model ExamAttempt {
  id            String    @id @default(cuid())
  userId        String
  sectionId     String
  attemptNumber Int // 1 | 2 | 3
  answers       String // JSON: [{concept, variant, selectedIndex, correct}]
  score         Float // 0-100
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  timeSpentSec  Int       @default(0)
  variantSeed   String // JSON: [{concept, variant}] audit trail

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId, attemptNumber])
  @@index([userId, sectionId])
}

// Exercise attempts with hint usage tracking
model ExerciseAttempt {
  id          String   @id @default(cuid())
  userId      String
  sectionId   String
  exerciseId  String
  usedHint    Boolean  @default(false)
  correct     Boolean  @default(false)
  attemptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sectionId, exerciseId])
}

// ═══════════════════════════════════════════════════════════
// SUBSCRIPTION SYSTEM — Multi-region (Peru + Worldwide)
// Supports: Stripe (global), MercadoPago (LATAM/Peru), Lemon Squeezy (MoR)
// ═══════════════════════════════════════════════════════════

// Subscription plans (seeded once, referenced by subscriptions)
model SubscriptionPlan {
  id              String   @id @default(cuid())
  code            String   @unique // "free" | "pro" | "team"
  name            String   // "Free" | "Pro" | "Team"
  description     String
  // Pricing per region — stored as JSON: { "PE": {"monthly": 29, "yearly": 290}, "US": {"monthly": 9.99, "yearly": 99}, "EU": {"monthly": 8.99, "yearly": 89} }
  // Amounts in local currency (PEN for PE, USD for US/EU/rest)
  pricingJSON     String
  featuresJSON    String // JSON array of feature strings
  maxSections     Int      @default(-1) // -1 = unlimited
  hasExams        Boolean  @default(true)
  hasPlayground   Boolean  @default(true)
  hasCertificate  Boolean  @default(false)
  hasMentorship   Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

// User's active subscription (1 per user at a time)
model Subscription {
  id              String   @id @default(cuid())
  userId          String   @unique // one active subscription per user
  planId          String
  status          String   @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED | EXPIRED | TRIALING
  billingCycle    String   @default("MONTHLY") // MONTHLY | YEARLY
  currency        String   @default("PEN") // PEN | USD | EUR
  amount          Float    // amount charged per cycle in `currency`
  provider        String   @default("MANUAL") // STRIPE | MERCADOPAGO | LEMON_SQUEEZY | MANUAL
  providerSubId   String?  // subscription ID from the payment provider
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  trialEnd           DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([status])
  @@index([provider])
}

// Payment records (one per charge)
model Payment {
  id              String   @id @default(cuid())
  userId          String
  subscriptionId  String?
  amount          Float    // amount charged
  currency        String   @default("PEN")
  provider        String   // STRIPE | MERCADOPAGO | LEMON_SQUEEZY | MANUAL
  providerPaymentId String? // payment intent / charge ID from provider
  status          String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  failureReason   String?
  createdAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId, status])
  @@index([provider, status])
}

// ═══════════════════════════════════════════════════════════
// SUPERVISOR & COHORT SYSTEM — Phase 6 data model
// Prisma is authoritative. Firebase remains optional mirror.
// ═══════════════════════════════════════════════════════════

// Supervisor profile and request tracking
model SupervisorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  status          String   @default("NOT_REQUESTED") // NOT_REQUESTED | PENDING | APPROVED | SUSPENDED | REJECTED | REVOKED
  entitlement     String   @default("PRO") // PRO | TEAM
  useCase         String?
  organization    String?
  anticipatedSize Int      @default(10)
  termsVersion    String   @default("1.0")
  requestedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?  // admin userId
  suspendedAt     DateTime?
  suspendReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Cohort owned by a supervisor
model Cohort {
  id              String   @id @default(cuid())
  ownerId         String   // User who owns this cohort
  name            String
  description     String?
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  visibilityJSON  String   @default("{}") // privacy settings
  reportingJSON   String   @default("{}") // reporting settings
  maxMembers      Int      @default(25)
  createdAt       DateTime @default(now())
  archivedAt      DateTime?
  updatedAt       DateTime @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberships     CohortMembership[]
  invitations     CohortInvitation[]
  auditEvents     CohortAuditEvent[]
  reports         ReportExport[]

  @@index([ownerId, status])
}

// Membership linking users to cohorts with scoped roles
model CohortMembership {
  id              String   @id @default(cuid())
  cohortId        String
  userId          String
  scopedRole      String   @default("COHORT_LEARNER") // COHORT_OWNER | COHORT_SUPERVISOR | COHORT_REPORTER | COHORT_LEARNER
  status          String   @default("ACTIVE") // ACTIVE | LEFT | REMOVED
  consentVersion  String   @default("1.0")
  invitedBy       String?
  removedBy       String?
  removalReason   String?
  joinedAt        DateTime @default(now())
  leftAt          DateTime?

  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([userId, status])
  @@index([cohortId, status])
}

// Invitation with secure token hash
model CohortInvitation {
  id              String   @id @default(cuid())
  cohortId        String
  invitedBy       String   // supervisor userId
  intendedUserId  String?  // existing user, if known
  intendedEmail   String?  // email for new users
  tokenHash       String   @unique // SHA-256 hash of the invitation token
  status          String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED | EXPIRED
  expiresAt       DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  cancelledAt     DateTime?
  deduplicationKey String? // cohortId + intendedEmail/UserId for preventing duplicates
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId, status])
  @@index([intendedEmail])
  @@index([intendedUserId])
}

// In-app notifications
model Notification {
  id              String   @id @default(cuid())
  recipientId     String   // user who receives the notification
  type            String   // supervisor_request_approved | invitation_received | etc.
  title           String
  body            String   // safe payload (no PII from other users)
  actionRoute     String?  // e.g. "/cohorts/abc/invitations/xyz"
  isRead          Boolean  @default(false)
  isDismissed     Boolean  @default(false)
  readAt          DateTime?
  dismissedAt     DateTime?
  deduplicationKey String? // prevent duplicate notifications
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, type, createdAt])

  recipient       User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

// Notification preferences per user
model NotificationPreference {
  userId          String   @id
  emailEnabled    Boolean  @default(true)
  inAppEnabled    Boolean  @default(true)
  digestFrequency String   @default("WEEKLY") // NONE | DAILY | WEEKLY | MONTHLY
  quietHoursStart Int      @default(22) // 24h format
  quietHoursEnd   Int      @default(7)
  locale          String   @default("es")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// Audit trail for cohort actions
model CohortAuditEvent {
  id              String   @id @default(cuid())
  cohortId        String
  actorId         String   // who performed the action
  action          String   // create_cohort | invite_learner | accept_invitation | etc.
  targetType      String?  // user | cohort | invitation
  targetId        String?
  beforeState     String?  // JSON snapshot
  afterState      String?  // JSON snapshot
  reason          String?
  requestId       String?  // for tracing
  createdAt       DateTime @default(now())

  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId, createdAt])
  @@index([actorId, createdAt])
}

// Report exports
model ReportExport {
  id              String   @id @default(cuid())
  requesterId     String
  cohortId        String
  reportType      String   // progress_summary | badge_report | inactivity_report | etc.
  filtersJSON     String   @default("{}")
  status          String   @default("PENDING") // PENDING | COMPLETED | FAILED | EXPIRED
  artifactPath    String?  // path to generated file
  rowCount        Int      @default(0)
  expiresAt       DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId, status])
  @@index([requesterId, createdAt])
}
