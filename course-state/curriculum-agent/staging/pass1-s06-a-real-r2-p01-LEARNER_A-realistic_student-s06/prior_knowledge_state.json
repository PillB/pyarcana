ence":0.98,"evidence_refs":["packet.json.active.iDo.steps[4]","packet.json.active.weDo.exercises[12]","packet.json.active.weDo.exercises[13]","packet.json.active.weDo.exercises[14]","packet.json.active.youDo.requirements"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[4]","learner_paraphrase":"En un pase cuento total y estados, busco el primer caso y divido rejects entre el total intentado; vacío da None."},{"concept_id":"readable-comprehensions","confidence":0.97,"evidence_refs":["packet.json.active.iDo.steps[5]","packet.json.active.weDo.exercises[15]","packet.json.active.weDo.exercises[16]","packet.json.active.weDo.exercises[17]"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[5]","learner_paraphrase":"Uso comprehensions para transformaciones y filtros sencillos; si la lógica crece, prefiero un for explícito."},{"concept_id":"loop-state-tracing","confidence":0.98,"evidence_refs":["packet.json.active.iDo.steps[6]","packet.json.active.weDo.exercises[18]","packet.json.active.weDo.exercises[19]","packet.json.active.weDo.exercises[20]"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[6]","learner_paraphrase":"Imprimo el estado después de cada fila para encontrar el primer paso donde un contador o acumulador deja de cuadrar."},{"concept_id":"linear-quadratic-off-by-one","confidence":0.98,"evidence_refs":["packet.json.active.iDo.steps[7]","packet.json.active.weDo.exercises[21]","packet.json.active.weDo.exercises[22]","packet.json.active.weDo.exercises[23]"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[7]","learner_paraphrase":"Un pase es O(n), un doble for es O(n²), y range(len(datos)) cubre los índices 0 hasta n-1 sin salirse."},{"concept_id":"batch-