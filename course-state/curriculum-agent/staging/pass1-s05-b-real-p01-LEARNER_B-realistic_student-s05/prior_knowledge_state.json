:"single-pass-counters-rates-search","confidence":0.97,"evidence_refs":["packet.json.active.iDo.steps[S04-T3-A-DEMO]","packet.json.active.weDo.exercises[S04-T3-A-E1]","packet.json.active.weDo.exercises[S04-T3-A-E2]","packet.json.active.youDo"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[S04-T3-A]","learner_paraphrase":"En un solo pase cuento cada registro una vez, busco casos y calculo reject sobre el total intentado; si no hay filas, la tasa es None."},{"concept_id":"readable-comprehensions","confidence":0.94,"evidence_refs":["packet.json.active.iDo.steps[S04-T3-B-DEMO]","packet.json.active.weDo.exercises[S04-T3-B-E1]","packet.json.active.weDo.exercises[S04-T3-B-E3]"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[S04-T3-B]","learner_paraphrase":"Uso comprehensions para filtros o transformaciones simples y mantengo el denominador de las tasas sobre el lote completo."},{"concept_id":"loop-state-tracing","confidence":0.96,"evidence_refs":["packet.json.active.iDo.steps[S04-T4-A-DEMO]","packet.json.active.weDo.exercises[S04-T4-A-E1]","packet.json.active.weDo.exercises[S04-T4-A-E3]"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[S04-T4-A]","learner_paraphrase":"Imprimo el estado después de cada decisión para localizar incrementos duplicados, valores pisados o acumulaciones incorrectas."},{"concept_id":"linear-quadratic-off-by-one","confidence":0.96,"evidence_refs":["packet.json.active.iDo.steps[S04-T4-B-DEMO]","packet.json.active.weDo.exercises[S04-T4-B-E1]","packet.json.active.weDo.exercises[S04-T4-B-E2]","packet.json.active.weDo.exercises[S04-T4-B-E3]"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[S04-T4-B]","learner_paraphrase":"Prefiero un pase O(n) para resúmenes; evito dobles bucles innecesarios y uso índices 0..len-1 para no perder ni exceder registros."}],"stale_for_final_convergence":true}
