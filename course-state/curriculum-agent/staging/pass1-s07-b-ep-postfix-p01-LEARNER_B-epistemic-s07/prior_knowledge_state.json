{"concepts":[{"concept_id":"sequences-slicing-tuples","confidence":0.99,"evidence_refs":["packet.json.active.theory[0]","S06-T1-A-E1","S06-T1-A-E2"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[0]","learner_paraphrase":"Las listas conservan secuencia y pueden mutar; las tuplas fijan un contrato, y el slicing crea ventanas nuevas."},{"concept_id":"alias-shallow-deep-copy","confidence":0.99,"evidence_refs":["packet.json.active.theory[1]","S06-T1-B-E2","S06-T1-B-E3"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[1]","learner_paraphrase":"El alias comparte todo; shallow separa solo el exterior; deepcopy separa también objetos anidados."},{"concept_id":"dict-index-safe-lookup","confidence":0.99,"evidence_refs":["packet.json.active.theory[2]","S06-T2-A-E1","S06-T2-A-E2"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[2]","learner_paraphrase":"Un dict indexa por clave; get modela ausencia esperada y corchetes exigen que la clave exista."},{"concept_id":"sets-dedup-conflicts","confidence":0.99,"evidence_refs":["packet.json.active.theory[3]","S06-T2-B-E2","S06-T2-B-E3"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[3]","learner_paraphrase":"Los sets sirven para pertenencia y cohortes, pero un dict seen conserva payloads para reportar conflictos."},{"concept_id":"nested-records-flattening","confidence":0.99,"evidence_refs":["packet.json.active.theory[4]","S06-T3-A-E2","S06-YOU-DO"],"example_seen":true,"guided_practice_completed":true,"independent_use_observed":true,"introduced_at":"packet.json.active.theory[4]","learner_paraphrase":"Un doble recorrido sigue cliente→transacción; la fila plana debe conservar client_id."},{"concept_id":"missing-empty-safe-n