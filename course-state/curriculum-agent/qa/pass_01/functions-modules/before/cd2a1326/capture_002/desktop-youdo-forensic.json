      {
        "tag": "pre",
        "text": "\"\"\"intake_quality_batch.py — cierre CP-N1-A (S04) Procesa múltiples registros sintéticos, resume tasas, conserva raw. Datos ficticios únicamente. No uses PII real. \"\"\" from __future__ import annotations from typing import Any def validate_record(record: dict[str, Any]) -> dict[str, Any]: \"\"\"Reutiliza lógica tipo S03: status global + detalle por campo. Mínimo: edad, region, monto_ingreso con accept|reject|review. \"\"\" # TODO: devolver {status, fields} con accept|reject|review por campo (S03) raise",
